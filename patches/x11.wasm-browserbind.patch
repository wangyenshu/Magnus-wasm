+/*
+ * Text input carries no modifier state; Tk derives the keysym from keycode
+ * and state, so mark characters on the shifted level of their keycode.
+ */
+static unsigned int
+BrowserTextEventState(
+    unsigned int keycode,
+    KeySym keySym,
+    unsigned int state)
+{
+    if ((BrowserKeySymForKeycodeLevel(keycode, 0) != keySym)
+	    && (BrowserKeySymForKeycodeLevel(keycode, 1) == keySym)) {
+	state |= ShiftMask;
+    }
+    return state;
+}
